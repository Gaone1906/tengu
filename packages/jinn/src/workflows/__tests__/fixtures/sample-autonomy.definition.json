{
  "schemaVersion": 1,
  "id": "sample-autonomy",
  "title": "Sample Autonomy Workflow",
  "description": "Generic workflow fixture for migration tests.",
  "version": 1,
  "status": "active",
  "orchestrator": "ops-lead",
  "nodes": [
    {
      "id": "__trigger",
      "type": "trigger",
      "label": "Manual trigger",
      "position": {
        "x": 240,
        "y": 0
      },
      "trigger": {
        "kind": "manual"
      }
    },
    {
      "id": "plan",
      "type": "step",
      "label": "Plan the work",
      "position": {
        "x": 240,
        "y": 140
      },
      "actor": {
        "kind": "employee",
        "ref": "ops-lead"
      },
      "role": "plan"
    },
    {
      "id": "implement",
      "type": "step",
      "label": "Implement the change",
      "position": {
        "x": 240,
        "y": 280
      },
      "actor": {
        "kind": "engine",
        "ref": "claude"
      },
      "role": "implement"
    },
    {
      "id": "verify",
      "type": "step",
      "label": "Verify the result",
      "position": {
        "x": 240,
        "y": 420
      },
      "actor": {
        "kind": "engine",
        "ref": "codex"
      },
      "role": "verify",
      "gates": [
        {
          "kind": "approval",
          "approvalRef": "operator-review",
          "description": "Operator accepts the result."
        }
      ]
    }
  ],
  "edges": [
    {
      "id": "e___trigger__plan",
      "from": "__trigger",
      "to": "plan",
      "kind": "sequence"
    },
    {
      "id": "e_plan__implement",
      "from": "plan",
      "to": "implement",
      "kind": "handoff"
    },
    {
      "id": "e_implement__verify",
      "from": "implement",
      "to": "verify",
      "kind": "handoff"
    }
  ]
}
